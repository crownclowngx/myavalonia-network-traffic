<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:NetWorkTrafficPlugin.Features.ProxyStatus"
 x:Class="NetWorkTrafficPlugin.Features.ProxyStatus.ProxyPanelView" x:DataType="vm:ProxyPanelModel">
 <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="8">
  <StackPanel Spacing="6">
   <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="启动代理" Command="{Binding StartCommand}" Padding="6,3"/>
    <Button Grid.Column="2" Content="停止代理" Command="{Binding StopCommand}" Padding="6,3"/>
   </Grid>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
    <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="复制代理地址" Click="CopyAddress" Padding="6,3"/>
   </Grid>
  </StackPanel>
  <ScrollViewer Grid.Row="1"><vm:ProxySettingsView/></ScrollViewer>
 </Grid>
</UserControl>

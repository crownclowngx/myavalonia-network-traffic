<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetWorkTrafficPlugin.Features.ProxyStatus"
             x:Class="NetWorkTrafficPlugin.Features.ProxyStatus.ProxyPanelView" x:DataType="vm:ProxyPanelModel">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="共享代理状态" FontSize="20" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusText}" FontSize="18" />
      <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" />
      <Button Content="复制代理地址" Click="CopyAddress" />
      <WrapPanel>
        <TextBox Width="110" Text="{Binding Port}" PlaceholderText="监听端口" Margin="0,0,8,0" />
        <Button Content="启动代理" Command="{Binding StartCommand}" Margin="0,0,8,0" />
        <Button Content="停止代理" Command="{Binding StopCommand}" />
      </WrapPanel>
      <ComboBox ItemsSource="{Binding CaptureModes}" SelectedIndex="{Binding CaptureModeIndex}" HorizontalAlignment="Stretch" />
      <TextBox Text="{Binding RecordDirectory}" PlaceholderText="本插件独立记录目录" />
      <TextBlock Text="端口或策略修改需要停止后再启动；关闭页面会继续捕获。" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ProtocolPolicy}" TextWrapping="Wrap" />
      <TextBlock x:Name="IdlePolicyNotice" Text="{Binding IdlePolicy}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding MetricsText}" TextWrapping="Wrap" />
      <TextBlock Text="最近请求（仅元信息）" FontWeight="SemiBold" />
      <TextBlock Text="{Binding RecentText}" TextWrapping="Wrap" />
      <Expander Header="本次运行的公开根证书（未安装系统信任）">
        <StackPanel Spacing="8">
          <TextBlock Text="仅供显式配置的测试客户端使用；重启代理会更换证书。此处没有私钥。" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CertificateInfo}" TextWrapping="Wrap" />
          <Button Content="复制公开证书" Click="CopyCertificate" />
          <TextBox Text="{Binding CertificatePem, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
